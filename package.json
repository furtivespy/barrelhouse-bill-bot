{
  "name": "barrelhouse-bill-bot",
  "version": "1.0.0",
  "packageManager": "bun@1.4.5",
  "description": "Discord bot that likes to drink bourbon",
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "test": "bun test",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:warnings": "biome lint --max-diagnostics=none --reporter=summary .",
    "verify": "bun scripts/verify.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "control": "bun --no-env-file scripts/control-bill.js",
    "start": "bun src/bot.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bugsnag/js": "^9.1.0",
    "@discordjs/rest": "^2.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "chalk": "6.0.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "moment": "^2.31.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
